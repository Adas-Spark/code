# Ignore everything by default
*

# But keep these specific files
!mass_email_app_v2.ipynb
!README.md
!.gitignore

# Always ignore these system/temp files (even if someone tries to force add them)
.DS_Store
.ipynb_checkpoints/
__pycache__/
*.pyc
.virtual_documents/

# Ignore common sensitive files
*.json
*.pickle
token.*
credentials.*
*.html
*.png
*.csv
*.jpg
*.jpeg
*.txt
